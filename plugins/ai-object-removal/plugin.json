{
  "id": "ai-object-removal",
  "name": "AI Object Removal",
  "version": "2.0.0",
  "category": "Image editing",
  "kind": "app",
  "provides": [
    "ops"
  ],
  "description": "Paint over an object and LaMa inpaints the background. Runs offline once the 198 MB model is downloaded. The result must be accepted before it is saved as a derivative.",
  "author": "Pigeon",
  "licence": "Apache-2.0",
  "source": "LaMa (Suvorov et al.), ONNX export by Carve",
  "operations": [
    "remove_object"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 2,
    "standalone": true,
    "requires": [
      "numpy",
      "Pillow",
      "onnxruntime"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "request": "run  (JSON on stdin)",
      "plugin": "run --plugin",
      "uninstall": "run --uninstall"
    }
  },
  "sdk": "python",
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "ui.py"
    },
    {
      "path": "ui_support.py"
    },
    {
      "path": "requirements.txt"
    }
  ],
  "models": [
    {
      "id": "lama-fp32",
      "name": "Simple LaMa (fp32)",
      "file": "lama_fp32.onnx",
      "url": "https://huggingface.co/Carve/LaMa-ONNX/resolve/c3c0c9e468934d62e79c329e35d82dd09ff8c444/lama_fp32.onnx",
      "bytes": 208044816,
      "sha256": "1faef5301d78db7dda502fe59966957ec4b79dd64e16f03ed96913c7a4eb68d6",
      "licence": "Apache-2.0"
    }
  ],
  "network": [
    "cas-bridge.xethub.hf.co",
    "cdn-lfs.huggingface.co",
    "files.pythonhosted.org",
    "hf.co",
    "huggingface.co",
    "pypi.org"
  ],
  "privacy": "Setup downloads the Python packages and model files once. Images and prompts are processed locally and never sent anywhere.",
  "ui": {
    "protocol": 2,
    "activation": "visible",
    "contributions": [
      {
        "slot": "inspector.panel",
        "id": "panel",
        "title": "AI Object Removal",
        "icon": "eraser",
        "order": 62,
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        }
      },
      {
        "slot": "asset.action",
        "id": "open",
        "title": "Remove object with AI…",
        "icon": "eraser",
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        },
        "selection": "one",
        "group": "AI"
      },
      {
        "slot": "modal",
        "id": "tool",
        "title": "AI Object Removal",
        "size": "large",
        "resizable": true,
        "modal": false
      }
    ],
    "permissions": [
      "selection",
      "library.write",
      "windows"
    ]
  }
}
