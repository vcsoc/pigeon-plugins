{
  "id": "ai-image-expand",
  "name": "AI Image Expand",
  "version": "2.0.0",
  "category": "Image editing",
  "kind": "app",
  "provides": [
    "ops"
  ],
  "description": "Enlarge the canvas and the model paints in the new border (outpainting). Uses MI-GAN, a 28 MB inpainting model, so it is fast on CPU. Your original pixels are never altered. The result must be accepted before it is saved as a derivative.",
  "author": "Pigeon",
  "licence": "MIT",
  "source": "MI-GAN (Picsart AI Research, ICCV 2023), ONNX pipeline export",
  "operations": [
    "expand"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 2,
    "standalone": true,
    "requires": [
      "numpy",
      "Pillow",
      "onnxruntime"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "request": "run  (JSON on stdin)",
      "plugin": "run --plugin",
      "uninstall": "run --uninstall"
    }
  },
  "sdk": "python",
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "ui.py"
    },
    {
      "path": "ui_support.py"
    },
    {
      "path": "requirements.txt"
    }
  ],
  "models": [
    {
      "id": "migan-512-places2",
      "name": "MI-GAN 512 (Places2, ONNX pipeline v2)",
      "file": "migan_pipeline_v2.onnx",
      "url": "https://huggingface.co/andraniksargsyan/migan/resolve/406830d0fa60666da0071c342ad2fbc8f30c5c64/migan_pipeline_v2.onnx",
      "bytes": 28079181,
      "sha256": "6f1f3530a1a2324b19752018ce756088b07973cda8d7d890034ace5c8a48c40b",
      "licence": "MIT"
    }
  ],
  "network": [
    "cas-bridge.xethub.hf.co",
    "cdn-lfs.huggingface.co",
    "files.pythonhosted.org",
    "hf.co",
    "huggingface.co",
    "pypi.org"
  ],
  "privacy": "Setup downloads the Python packages and model files once. Images and prompts are processed locally and never sent anywhere.",
  "ui": {
    "protocol": 2,
    "activation": "visible",
    "contributions": [
      {
        "slot": "inspector.panel",
        "id": "panel",
        "title": "AI Image Expand",
        "icon": "frame-corners",
        "order": 63,
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        }
      },
      {
        "slot": "asset.action",
        "id": "open",
        "title": "Expand canvas with AI…",
        "icon": "frame-corners",
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        },
        "selection": "one",
        "group": "AI"
      },
      {
        "slot": "modal",
        "id": "tool",
        "title": "AI Image Expand",
        "size": "large",
        "resizable": true,
        "modal": false
      }
    ],
    "permissions": [
      "selection",
      "library.write",
      "windows"
    ]
  }
}
