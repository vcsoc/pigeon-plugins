{
  "id": "ai-enlarge",
  "name": "AI Image Enlarger",
  "version": "1.1.1",
  "category": "Image editing",
  "kind": "editor-worker",
  "description": "Offline 3x image enlargement with a sub-pixel convolutional neural network. The model is tiny (235 KB) and ships inside the plugin; only Python packages are installed once, at setup.",
  "author": "Pigeon",
  "licence": "Apache-2.0",
  "source": "ONNX Model Zoo (super_resolution 10)",
  "operations": [
    "enlarge"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 1,
    "standalone": true,
    "requires": [
      "numpy",
      "Pillow",
      "onnxruntime"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "request": "run  (JSON on stdin)"
    }
  },
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "requirements.txt"
    },
    {
      "path": "model/super-resolution-10.onnx",
      "role": "model"
    }
  ],
  "models": [],
  "network": [
    "files.pythonhosted.org",
    "pypi.org"
  ],
  "privacy": "Runs entirely on this computer. Images are never sent anywhere. Setup installs Python packages from PyPI once."
}
