{
  "id": "ai-enlarge",
  "name": "AI Image Enlarger",
  "version": "2.0.0",
  "category": "Image editing",
  "kind": "app",
  "provides": [
    "ops"
  ],
  "description": "Offline 3x image enlargement with a sub-pixel convolutional neural network. The model is tiny (235 KB) and ships inside the plugin; only Python packages are installed once, at setup.",
  "author": "Pigeon",
  "licence": "Apache-2.0",
  "source": "ONNX Model Zoo (super_resolution 10)",
  "operations": [
    "enlarge"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 2,
    "standalone": true,
    "requires": [
      "numpy",
      "Pillow",
      "onnxruntime"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "request": "run  (JSON on stdin)",
      "plugin": "run --plugin",
      "uninstall": "run --uninstall"
    }
  },
  "sdk": "python",
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "ui.py"
    },
    {
      "path": "ui_support.py"
    },
    {
      "path": "requirements.txt"
    },
    {
      "path": "model/super-resolution-10.onnx",
      "role": "model"
    }
  ],
  "models": [],
  "network": [
    "files.pythonhosted.org",
    "pypi.org"
  ],
  "privacy": "Runs entirely on this computer. Images are never sent anywhere. Setup installs Python packages from PyPI once.",
  "ui": {
    "protocol": 2,
    "activation": "visible",
    "contributions": [
      {
        "slot": "inspector.panel",
        "id": "panel",
        "title": "AI Image Enlarger",
        "icon": "magnifying-glass-plus",
        "order": 60,
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        }
      },
      {
        "slot": "asset.action",
        "id": "open",
        "title": "Enlarge with AI…",
        "icon": "magnifying-glass-plus",
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        },
        "selection": "one",
        "group": "AI"
      },
      {
        "slot": "modal",
        "id": "tool",
        "title": "AI Image Enlarger",
        "size": "medium",
        "resizable": true,
        "modal": false
      }
    ],
    "permissions": [
      "selection",
      "library.write",
      "windows"
    ]
  }
}
