{
  "id": "ai-image-expand-diffusion",
  "name": "AI Image Expand (Diffusion)",
  "version": "1.1.0",
  "category": "Image editing",
  "kind": "editor-worker",
  "description": "Enlarge the canvas by any amount and Stable Diffusion 1.5 Inpainting paints in the new border at full resolution, continuing the scene. About 2.1 GB of models, runs offline on CPU and is slow (minutes to hours for large images). Your original pixels are never altered. The result must be accepted before it is saved as a derivative.",
  "author": "Pigeon",
  "licence": "CreativeML OpenRAIL-M",
  "source": "Stable Diffusion 1.5 Inpainting (RunwayML / Stability AI), fp16 ONNX conversion by RanaLLC; the safety checker is intentionally not included",
  "operations": [
    "expand"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 1,
    "standalone": true,
    "requires": [
      "numpy",
      "Pillow",
      "onnxruntime"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "request": "run  (JSON on stdin)"
    }
  },
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "requirements.txt"
    },
    {
      "path": "requirements-cuda.txt"
    }
  ],
  "models": [
