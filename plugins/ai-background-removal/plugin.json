{
  "id": "ai-background-removal",
  "name": "AI Background Removal",
  "version": "2.0.0",
  "category": "Image editing",
  "kind": "app",
  "provides": [
    "ops"
  ],
  "description": "Remove the background from a saved image with U2-Net-P, entirely offline once the 4.5 MB model is downloaded. A preview must be accepted before anything is saved.",
  "author": "Pigeon",
  "licence": "Apache-2.0",
  "source": "U2-Net (Qin et al.) as distributed by rembg",
  "operations": [
    "remove_background"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 2,
    "standalone": true,
    "requires": [
      "numpy",
      "Pillow",
      "onnxruntime"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "request": "run  (JSON on stdin)",
      "plugin": "run --plugin",
      "uninstall": "run --uninstall"
    }
  },
  "sdk": "python",
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "ui.py"
    },
    {
      "path": "ui_support.py"
    },
    {
      "path": "requirements.txt"
    }
  ],
  "models": [
    {
      "id": "u2netp",
      "name": "U2-Net-P",
      "file": "u2netp.onnx",
      "url": "https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx",
      "bytes": 4574861,
      "sha256": "309c8469258dda742793dce0ebea8e6dd393174f89934733ecc8b14c76f4ddd8",
      "licence": "Apache-2.0"
    }
  ],
  "network": [
    "files.pythonhosted.org",
    "github.com",
    "objects.githubusercontent.com",
    "pypi.org",
    "release-assets.githubusercontent.com"
  ],
  "privacy": "Setup downloads the Python packages and model files once. Images and prompts are processed locally and never sent anywhere.",
  "ui": {
    "protocol": 2,
    "activation": "visible",
    "contributions": [
      {
        "slot": "inspector.panel",
        "id": "panel",
        "title": "AI Background Removal",
        "icon": "scissors",
        "order": 61,
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        }
      },
      {
        "slot": "asset.action",
        "id": "open",
        "title": "Remove background with AI…",
        "icon": "scissors",
        "applies_to": {
          "kinds": [
            "image"
          ],
          "min": 1,
          "max": 1
        },
        "selection": "one",
        "group": "AI"
      },
      {
        "slot": "modal",
        "id": "tool",
        "title": "AI Background Removal",
        "size": "medium",
        "resizable": true,
        "modal": false
      }
    ],
    "permissions": [
      "selection",
      "library.write",
      "windows"
    ]
  }
}
