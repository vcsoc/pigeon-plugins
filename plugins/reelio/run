#!/bin/sh
# Reelio plugin launcher (standalone native layout). Needs only this folder.
#   run --plugin      serve protocol v2 on stdin/stdout (the host starts this)
#   run --version     print the plugin version
#   run --uninstall   confirm uninstall (Reelio keeps no external state)
# The binary is bin/reelio when shipped as an artifact; otherwise it is built from crates/app with
# cargo into .data/target (developer mode). Nothing is downloaded by this script.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd -P)
DATA=${PIGEON_PLUGIN_DATA:-$HERE/.data}
ARTIFACT="$HERE/bin/reelio"
TARGET=${CARGO_TARGET_DIR:-$DATA/target}
BIN="$ARTIFACT"
[ -x "$BIN" ] || BIN="$TARGET/release/reelio"
case "${1:-}" in
  --setup)
    if [ ! -x "$ARTIFACT" ]; then
      PATH="$PATH:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      export PATH
      if ! command -v cargo >/dev/null 2>&1; then
        printf '{"ok":false,"error":"reelio binary missing and cargo not found"}\n'
        exit 1
      fi
      CARGO_TARGET_DIR="$TARGET" cargo build --release --quiet --manifest-path "$HERE/Cargo.toml" -p reelio-app >&2
    fi
    mkdir -p "$DATA"
    "$BIN" --setup
    touch "$DATA/setup.ok"
    ;;
  --plugin)
    if [ ! -f "$DATA/setup.ok" ] || [ ! -x "$BIN" ]; then
      printf '{"ok":false,"error":"Reelio is not set up. Run: sh run --setup"}\n'
      exit 1
    fi
    exec "$BIN" "$@"
    ;;
  --version|--uninstall)
    if [ -x "$BIN" ]; then exec "$BIN" "$@"; fi
    if [ "$1" = --uninstall ]; then printf '{"ok":true,"removed":[]}\n'; else printf '2.0.0\n'; fi
    ;;
  *) printf '{"ok":false,"error":"Unknown Reelio launcher mode"}\n'; exit 2 ;;
esac
