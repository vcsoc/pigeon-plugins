{
  "id": "semantic-search",
  "name": "Local Semantic Search",
  "version": "1.1.0",
  "category": "Search",
  "kind": "semantic-index",
  "description": "Private multimodal similarity search, knowledge-graph clustering and tag suggestions using EmbeddingGemma 2 (768-dim embeddings of text, images and video), computed on this computer. Setup downloads about 1.5 GB once. Runs as a standalone engine that Pigeon talks to over a simple line protocol.",
  "author": "Pigeon",
  "licence": "Apache-2.0",
  "operations": [
    "embed"
  ],
  "worker": {
    "runtime": "python3",
    "python": ">=3.10,<3.14",
    "entry": "run",
    "protocol": 1,
    "standalone": true,
    "requires": [
      "sentence-transformers",
      "Pillow"
    ],
    "requirementsFile": "requirements.txt",
    "commands": {
      "setup": "run --setup",
      "health": "run --health [--verify]",
      "selfTest": "run --self-test",
      "serve": "run --serve <index.db>",
      "request": "run  (JSON on stdin)"
    }
  },
  "files": [
    {
      "path": "plugin.json"
    },
    {
      "path": "run",
      "executable": true
    },
    {
      "path": "plugin_runtime.py"
    },
    {
      "path": "worker.py"
    },
    {
      "path": "semantic-engine.py"
    },
    {
      "path": "requirements.txt"
    }
  ],
